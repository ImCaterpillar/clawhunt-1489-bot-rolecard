{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/schema/bot_rolecard.schema.json",
  "title": "Bot Role Card",
  "description": "企业多 Agent 系统中单个 Bot 的结构化角色卡。定义角色、职责、知识挂载与工具权限。",
  "type": "object",
  "required": [
    "role_card_version",
    "bot_id",
    "display_name",
    "role",
    "responsibilities",
    "knowledge_mounts",
    "tool_permissions",
    "domain"
  ],
  "additionalProperties": false,
  "properties": {
    "role_card_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "角色卡规范版本（必填）"
    },
    "bot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Bot 唯一标识，小写字母开头，可含数字与连字符（必填）"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "展示名称（必填）"
    },
    "domain": {
      "type": "string",
      "enum": ["enterprise_management", "customer_operation"],
      "description": "所属数据域，决定可见知识范围（必填）"
    },
    "role": {
      "type": "object",
      "required": ["title", "purpose"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 64},
        "purpose": {"type": "string", "minLength": 10, "maxLength": 500},
        "escalation": {
          "type": "string",
          "enum": ["none", "human_review", "supervisor_bot"],
          "default": "human_review"
        }
      },
      "description": "角色定义（必填）"
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]{2,3}$"},
          "description": {"type": "string", "minLength": 5, "maxLength": 300},
          "in_scope": {"type": "boolean", "default": true}
        }
      },
      "description": "职责清单，in_scope=false 表示明确不在本 Bot 范围（必填）"
    },
    "knowledge_mounts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["mount_id", "source", "access"],
        "additionalProperties": false,
        "properties": {
          "mount_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
          "source": {"type": "string", "minLength": 1},
          "access": {"type": "string", "enum": ["read", "read_write"]},
          "citation_required": {"type": "boolean", "default": true},
          "acl_scope": {
            "type": "array",
            "items": {"type": "string"},
            "description": "允许访问该挂载点的角色/部门"
          }
        }
      },
      "description": "知识挂载点（可为空数组）"
    },
    "tool_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "mode"],
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "code_execution", "web_browsing", "file_editing",
              "file_transfer", "git_operations", "terminal_access",
              "visual_observation"
            ]
          },
          "mode": {"type": "string", "enum": ["deny", "read", "write"]},
          "requires_approval": {"type": "boolean", "default": false}
        }
      },
      "description": "工具权限，最小权限原则：未列出即 deny（必填）"
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean", "default": false},
        "approver_role": {"type": "string"},
        "applies_to": {"type": "array", "items": {"type": "string"}}
      },
      "description": "强制人工审核门（可选）"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "扩展字段（可选）"
    }
  }
}
